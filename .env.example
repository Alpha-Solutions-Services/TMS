# Alpha Freight Network TMS
NEXT_PUBLIC_TMS_URL=https://your-tms-domain.example
NEXT_PUBLIC_SITE_URL=https://your-site-domain.example
# Optional — used by some shared/portal-linked helpers
NEXT_PUBLIC_PORTAL_URL=https://portal.alphasolutions.software

# Supabase (same project as Portal)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sanity (shared CMS project — portal-data helpers / optional content)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Super dispatchers (comma-separated) — full access + approval queue
# Env list = bootstrap supers; add more via tms_users (role: super_dispatcher or sub_dispatcher)
SUPER_DISPATCHER_EMAILS=super1@example.com,super2@example.com

# Staff / owner allowlists (admin panels, reports)
ADMIN_EMAILS=you@example.com,teammate@example.com
OWNER_EMAILS=owner@example.com
SUPER_ADMIN_EMAILS=owner@example.com
DISPATCHER_EMAILS=dispatcher@example.com

# Optional SMTP for notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password-here
SMTP_FROM=Alpha Freight Network <alphaassistant.alpha@gmail.com>
AUTH_OPS_NOTIFY_EMAIL=ops@example.com
CONTACT_EMAIL=ops@example.com
EMAIL_LOGO_URL=https://www.alphasolutions.software/icon.png
# Public contact shown to carriers (not SMTP From)
FREIGHT_SUPPORT_EMAIL=support@freight.alphasolutions.software
FREIGHT_TEAM_EMAIL=alphaassistant.alpha@gmail.com

# Invoice emails — send as this mailbox (preferred)
DISPATCH_INVOICE_FROM=Alpha Invoice & Payment <invoice.payment.alpha@gmail.com>
# Required for Gmail to actually send FROM that address (use that account's app password)
DISPATCH_INVOICE_SMTP_HOST=smtp.gmail.com
DISPATCH_INVOICE_SMTP_PORT=587
DISPATCH_INVOICE_SMTP_SECURE=false
DISPATCH_INVOICE_SMTP_USER=invoice.payment.alpha@gmail.com
DISPATCH_INVOICE_SMTP_PASS=your-invoice-gmail-app-password
# DISPATCH_INVOICE_BCC=ops@example.com

# Invoice PDF / email branding (optional)
DISPATCH_INVOICE_BRAND_NAME=Alpha Freight Network
DISPATCH_INVOICE_COMPANY_NAME=Alpha Solutions Services LLC
DISPATCH_INVOICE_CONTACT_NAME=Dispatch
DISPATCH_INVOICE_WEBSITE=https://www.alphasolutions.software
DISPATCH_INVOICE_ADDRESS_LINE1=your-address-line-1
DISPATCH_INVOICE_ADDRESS_LINE2=your-address-line-2
DISPATCH_INVOICE_ZELLE_NAME=your-zelle-name
DISPATCH_INVOICE_ZELLE_NUMBER=your-zelle-number
DISPATCH_INVOICE_ZELLE_NAME_2=
DISPATCH_INVOICE_ZELLE_NUMBER_2=
DISPATCH_INVOICE_ZELLE_EMAIL_2=

# Groq AI — load board paste parsing + freight assistant
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Cal.com booking links (optional)
CAL_COM_URL=https://cal.com/your-link
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/your-link

# Google Sheets sync (optional — carrier roster / dispatch board)
GOOGLE_CARRIER_SHEET_CSV_URL=
GOOGLE_CARRIER_SHEET_GID=
GOOGLE_CARRIER_SHEET_TAB=
GOOGLE_DISPATCH_SHEET_CSV_URL=
GOOGLE_DISPATCH_SHEET_GID=
GOOGLE_DISPATCH_SHEET_ID=
GOOGLE_DISPATCH_SHEET_MONTH_GIDS=
GOOGLE_DISPATCH_SHEET_TAB=
GOOGLE_DISPATCH_SHEET_USE_MONTH_TAB=

# FMCSA lookup (optional)
FMCSA_API_KEY=your-fmcsa-api-key-here

# Cron (optional)
CRON_SECRET=generate_a_long_random_string

# Web Push — wake driver phone for live GPS (run: npx web-push generate-vapid-keys)
# Required for push alerts when the driver app is backgrounded. Email wake works without these.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@alphasolutions.software
